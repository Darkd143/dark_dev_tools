    "action": {
      "type": "minecraft:show_dialog",
      "dialog": "dark_mannequin:menu"
    }
  },
  "columns": 1,
  "actions": [
    {
      "label": [{"text":"Default "},{"player":""}],
      "tooltip": "Summon Default Mannequin (Alex)",
      "action": {
        "type": "minecraft:run_command",
        "command": "/trigger dark_mannequin.summon set -2"
      }
    },
    {
      "label": [{"text":"Default "},{"player":"Alex"}],
      "tooltip": "Summon Default Mannequin (Alex)",
      "action": {
        "type": "minecraft:run_command",
        "command": "/trigger dark_mannequin.summon set -3"
      }
    },
    {
      "label": [{"selector":"@s"},{"text":" Mannequin"}],
      "tooltip": "Summon Player Mannequin of yourself",
      "action": {
        "type": "minecraft:run_command",
        "command": "/trigger dark_mannequin.summon set -4"
      }
    },
    {
      "label": "Player Mannequin Menu",
      "tooltip": "Select a player to summon a mannequin of",
      "action": {
        "type": "minecraft:run_command",
        "command": "/trigger dark_mannequin.summon set -5"
      }
